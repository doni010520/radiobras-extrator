# =============================================================================
# radiobras-extrator — variáveis de ambiente
#
# Este arquivo é um MODELO (sem segredos). No EasyPanel, cadastre em
# Settings → Environment. Localmente, copie para `.env` (que é gitignored).
#
# Ao TROCAR DE VPS: copie os valores do painel atual — principalmente o
# ODONTO_PROXY_URL, que não existe em nenhum outro lugar do repositório.
# =============================================================================

# ── OBRIGATÓRIAS — sem qualquer uma delas o faturamento não funciona ─────────

# PRORADIS / SmartRIS (de onde vêm laudos e imagens)
SMARTRIS_EMAIL=
SMARTRIS_PASSWORD=

# OdontoPrev / RedeUna (onde as guias são anexadas).
# O usuário é o código do credenciado; a senha é a mesma para as 3 contas.
# As senhas por unidade também ficam no banco (tela /portal) e têm precedência.
ODONTOPREV_USER=
ODONTOPREV_PASSWORD=

# Proxy residencial BR, SOMENTE para o OdontoPrev (o PRORADIS é acessado direto).
# O portal bloqueia IP de datacenter — sem isto o login falha e NADA fatura.
# VPS nova = IP novo: esta variável é a que mais se esquece numa migração.
# Formato: http://usuario:senha@host:porta
# Se o usuário contiver ";sessid.<x>", o código troca o token a cada sessão.
ODONTO_PROXY_URL=

# Postgres (Supabase). O banco é EXTERNO: numa migração não há dado a mover,
# basta apontar a mesma URL. Sem isto o app cai em SQLite efêmero e o histórico
# some a cada redeploy.
DATABASE_URL=

# Gemini — usado só para LER/transcrever anexos (quem decide é o código).
# Sem esta chave o estágio de leitura não roda e o dia inteiro vira pendência.
GEMINI_API_KEY=

# Assina o cookie de sessão. Sem ela, o app gera uma chave aleatória a cada boot
# e todos são deslogados a cada deploy.
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── AGENDADORES — desligados por padrão. Ligue UM DE CADA VEZ ────────────────
# Os três competem pelo mesmo login do OdontoPrev; a soma deles já derrubou o
# container por memória. Ative um, observe uma execução, depois o próximo.
FATURAR_CRON=0
FATURAR_CRON_HOUR=5
GLOSA_AUTO_UPDATE=0
GLOSA_UPDATE_HOUR=6
ANEXACAO_AUTO_UPDATE=0
ANEXACAO_UPDATE_HOUR=7
RESUMO_FAT_AUTO=0
RESUMO_FAT_HOUR=8

# ── ALERTA DE PRAZO (SLA) por e-mail — opcional ──────────────────────────────
# Sem SMTP o e-mail é pulado e a tela /revisao continua mostrando os alertas.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERTA_EMAIL_TO=
ALERTA_SLA=1

# ── AJUSTES (têm padrão sensato; mexa só se precisar) ────────────────────────

# Prazo de faturamento usado no cálculo do SLA. ATENÇÃO: o portal fecha a janela
# de anexação bem depois disso — medido em 25/07, guias de 7 a 10 dias anexaram
# normalmente e uma de 16 dias já não aceitava anexo.
FATURAR_PRAZO_DIAS=7

# Dias que os documentos da tela de Revisão ficam em disco. 90 porque uma
# pendência fica aberta enquanto alguém não providencia laudo ou solicitação —
# com 7 dias, 2/3 das pendências abertas perderiam os documentos.
REVIEW_TTL_DIAS=90

# ESTEIRA_KEY foi removida em 27/07 junto com as rotas /admin/esteira/* — pode
# apagar essa variável do ambiente. Use /faturar (dispara) e /revisao (backlog).

# Cifra a senha do portal guardada no banco (tabela portal_credenciais). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem ela o sistema segue funcionando, porém a senha fica em TEXTO PURO — quem
# tiver a DATABASE_URL passa a ter o login do convênio das três unidades.
PORTAL_KEY=

# Senha do admin inicial. Em produção é OBRIGATÓRIA: sem ela o admin não é criado
# (antes havia um fallback fixo, e ele estava num repositório PÚBLICO).
ADMIN_PASSWORD=

# Porta do servidor (o EasyPanel costuma injetar sozinho).
PORT=8000
